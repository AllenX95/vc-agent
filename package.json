{
  "name": "vc-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @vc-agent/agent-worker build && pnpm --filter @vc-agent/desktop build",
    "dev": "pnpm build && electron apps/desktop/dist/main/main.js",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@vc-agent/capabilities": "workspace:*",
    "@vc-agent/contracts": "workspace:*",
    "@vc-agent/host-services": "workspace:*",
    "@vc-agent/persistence": "workspace:*",
    "@vc-agent/pi-adapter": "workspace:*",
    "electron": "43.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
